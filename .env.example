# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Comma-separated Telegram user IDs (private chat with @userinfobot — positive integers only).
# The bot only accepts commands and chat bridge traffic from these users in private DMs.
ADMIN_CHAT_IDS=11111111,22222222

# Optional cosmetic Minecraft server settings
SERVER_NAME=My Minecraft Server
MOTD=Welcome!

# Timezone used by Watchtower's auto-update cron schedule (default UTC).
# Pick anything tzdata recognises, e.g. Africa/Johannesburg, Europe/Berlin.
TZ=UTC

# Optional: absolute host path with docker-compose.yml — enables /update and /restore
# when you bind-mount that directory read-only on mc-guard as /project (see README).
# CREEPWATCH_PROJECT_DIR=/opt/minecraft

# Optional: absolute host path to the backups folder for docker run -v (only if not PROJECT_DIR/backups).
# Without this and without CREEPWATCH_PROJECT_DIR, mc-guard auto-discovers the host path by
# inspecting its own /backups bind mount (`docker inspect mc-guard`), which works on a fresh deploy.
# CREEPWATCH_BACKUP_DIR_HOST=/opt/minecraft/backups

# Optional: how many `pre-restore-<TS>.tar.gz` safety snapshots restore.sh keeps (default 3).
# These are taken automatically before every /restore so the live world can be recovered.
# RESTORE_PRERESTORE_KEEP=3

# Optional: where backup.sh / restore.sh append their persistent log (visible via /logs).
# Default /data/logs, falls back to /tmp/creepwatch-logs if /data is not writable.
# BACKUP_LOG_DIR=/data/logs
# RESTORE_LOG_DIR=/data/logs

# Backups land in ./backups on the host (mounted at /backups in mc-guard). Override path inside the container if needed.
# CREEPWATCH_BACKUP_DIR=/backups

# Optional: Cloudflare R2 after each successful local tarball (S3-compatible API).
# Create an R2 bucket + API token (Object Read & Write on that bucket only). Do not commit real values.
# R2_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=my-world-backups
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_PREFIX=minecraft/
# Max objects kept by the 24h-gap slot rule on R2 and locally (default 3).
# Same-day repeats only refresh slot 1; slot 2/3 require ≥24h gap.
# R2_RETAIN_COUNT=3
# Override the slot count when R2 is not configured (default 3, mirrors R2_RETAIN_COUNT).
# BACKUP_SLOT_COUNT=3
# Force a flat newest-N retention (overrides slot rule). Use only if the
# 24h-gap behaviour does not fit; you'll lose slot 2/3 anchoring.
# BACKUP_MAX_ARCHIVES=3

# Preflight / integrity (scripts/backup.sh): min free MiB on backup volume, min tarball size, skip all checks (emergency only).
# BACKUP_MIN_FREE_MB=512
# BACKUP_MIN_ARCHIVE_BYTES=1048576
# BACKUP_SKIP_PREFLIGHT=1
# BACKUP_STRICT_GZIP_TEST=1
# Optional: image with GNU gzip for postflight (default debian:bookworm-slim).
# BACKUP_GZIP_TOOLS_IMAGE=debian:bookworm-slim

# Seconds between writes to /data/.creepwatch_heartbeat (host monitoring).
# CREEPWATCH_HEARTBEAT_SEC=600

# Optional: Healthchecks.io / Cronitor / similar — GET this URL each heartbeat (same interval as above).
# CREEPWATCH_HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
