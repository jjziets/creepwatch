# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Comma-separated Telegram user IDs (private chat with @userinfobot — positive integers only).
# The bot only accepts commands and chat bridge traffic from these users in private DMs.
ADMIN_CHAT_IDS=11111111,22222222

# Optional cosmetic Minecraft server settings
SERVER_NAME=My Minecraft Server
MOTD=Welcome!

# Timezone used by Watchtower's auto-update cron schedule (default UTC).
# Pick anything tzdata recognises, e.g. Africa/Johannesburg, Europe/Berlin.
TZ=UTC

# Optional: absolute host path with docker-compose.yml — enables /update and /restore
# when you bind-mount that directory read-only on mc-guard as /project (see README).
# CREEPWATCH_PROJECT_DIR=/opt/minecraft

# Backups land in ./backups on the host (mounted at /backups in mc-guard). Override path inside the container if needed.
# CREEPWATCH_BACKUP_DIR=/backups

# Seconds between writes to /data/.creepwatch_heartbeat (host monitoring).
# CREEPWATCH_HEARTBEAT_SEC=600

# Optional: Healthchecks.io / Cronitor / similar — GET this URL each heartbeat (same interval as above).
# CREEPWATCH_HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
