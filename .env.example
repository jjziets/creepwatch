# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Comma-separated Telegram chat IDs of admins.
# Find your chat ID by messaging @userinfobot.
ADMIN_CHAT_IDS=11111111,22222222

# Optional cosmetic Minecraft server settings
SERVER_NAME=My Minecraft Server
MOTD=Welcome!

# Timezone used by Watchtower's auto-update cron schedule (default UTC).
# Pick anything tzdata recognises, e.g. Africa/Johannesburg, Europe/Berlin.
TZ=UTC
